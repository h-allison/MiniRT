* floor & wall
pl	0,-2,0			0,-1,0					200,200,200
*******************************************************************************
* cylinder on-the-floor placement is +0.5 in y to account for -0.5 minimum
* it is necessary for min & max to both be 0.5 to rotate on true center axis
cy	-2,1.5,0	-1,0,0		0.5 1		250,100,100
cy	0,1.5,0		0,-1,0		0.5 1		100,250,100
cy	2,1.5,0		0,0,-1		0.5 1		100,100,250
cy	-2,0,0		1,-1,0		0.5 1		250,100,100
cy	0,0,0		0,1,1		0.5 1		100,250,100
cy	2,0,0		1,0,-1		0.5 1		100,100,250
