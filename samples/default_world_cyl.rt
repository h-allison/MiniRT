*******************************************************************************
* This file replicates our default_world_cyl() scene
* See commented-out code below for details
*******************************************************************************
A 	0.2									255,255,255
*******************************************************************************
* 	camera vector = normalized (point(0,1,0) - point(-2,2,-6))
*					 = normalized(vector(2,-1,6))
*				
*														(M_PI/3) * RAD2DEG = 60
 C 	-2,2,-6			 0.312348,-0.156174,0.937043				60
*******************************************************************************
* floor & wall
pl	0,0,0			0,1,0					200,200,200
*******************************************************************************
* spheres
sp	.5,1,4				1				140,130,100
sp	-0.2,1,-2			1				10,20,15
*******************************************************************************
* cylinders ** increasing color for visibility
* left->maximum = 2 * scaling 0,5 in y = 1 height
* cylinder placement is +0.5 to account for -0.5 minimum
* it is necessary for min & max to both be 0.5 to rotate on true axis
cy	-2.5,0.8,2		0,1,0		0.5 1		200,100,100
*******************************************************************************
L	-7,7,-6				1				200,200,180
L	-4,8,2				1				180,120,120
*******************************************************************************
